name: Access Directly
desc: Apple/RU/BY/KG direct, Pandora via US nodes, AdGuard DoH

mode: rule

dns:
  default-nameserver: #!replace
    - 94.140.14.14
    - 94.140.15.15

  nameserver: #!replace
    - https://dns.adguard-dns.com/dns-query

proxy-groups:
  - name: US nodes
    type: url-test
    include-all: true
    filter: '(?i)(🇺🇸|\bUS\b|\bUSA\b|United States|America|США|Америка|Los Angeles|New York|Chicago|Dallas|Miami|Seattle|San Jose|Ashburn|Phoenix|Atlanta|Denver|Virginia)'

rules:
  # Apple services directly.
  - GEOSITE,apple,DIRECT

  # Russian domains/services/IPs directly.
  - GEOSITE,category-ru,DIRECT
  - GEOIP,RU,DIRECT

  # Belarus domains and IPs directly.
  - DOMAIN-SUFFIX,by,DIRECT
  - GEOIP,BY,DIRECT

  # Kyrgyzstan domains and IPs directly.
  - DOMAIN-SUFFIX,kg,DIRECT
  - GEOIP,KG,DIRECT

  # Pandora Radio through US proxy nodes.
  - DOMAIN-SUFFIX,pandora.com,US nodes
  - DOMAIN-SUFFIX,p-cdn.us,US nodes
  - DOMAIN-SUFFIX,p-cdn.com,US nodes

  # Check automatically selected US exit node.
  - DOMAIN-SUFFIX,ifconfig.net,US nodes
