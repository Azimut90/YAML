name: Routing & Privacy Overrides
desc: Apple/RU/BY/KG direct, Pandora via selected route, AdGuard DoH, ads/trackers filtering

mode: rule

dns:
  default-nameserver: #!replace
    - 94.140.14.14
    - 94.140.15.15

  nameserver: #!replace
    - https://dns.adguard-dns.com/dns-query

proxy-groups:
  - name: US nodes
    type: select
    proxies:
      - "→ Remnawave"
    include-all: true
    filter: '(?i)(Remnawave|🇺🇸|\bUS\b|\bUSA\b|United States|America|США|Америка|Los Angeles|New York|Chicago|Dallas|Miami|Seattle|San Jose|Ashburn|Phoenix|Atlanta|Denver|Virginia)'

rule-providers:
  hagezi-pro-mini:
    behavior: domain
    format: text
    url: https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/pro.mini.txt
    path: ./rules/hagezi-pro-mini.txt
    interval: 86400

rules:
  # Ads, trackers, telemetry, metrics, and common threats.
  - RULE-SET,hagezi-pro-mini,REJECT,no-track

  # Pandora and related services.
  - DOMAIN-SUFFIX,pandora.com,US nodes
  - DOMAIN-SUFFIX,p-cdn.us,US nodes
  - DOMAIN-SUFFIX,p-cdn.com,US nodes
  - DOMAIN-SUFFIX,siriusxm.com,US nodes
  - DOMAIN-SUFFIX,savagebeast.com,US nodes
  - DOMAIN-SUFFIX,urbanairship.com,US nodes

  # Apple services directly.
  - GEOSITE,apple,DIRECT

  # Russian domains/services/IPs directly.
  - GEOSITE,category-ru,DIRECT
  - GEOIP,RU,DIRECT

  # Belarus domains and IPs directly.
  - DOMAIN-SUFFIX,by,DIRECT
  - GEOIP,BY,DIRECT

  # Kyrgyzstan domains and IPs directly.
  - DOMAIN-SUFFIX,kg,DIRECT
  - GEOIP,KG,DIRECT

  # Check automatically selected US exit node.
  - DOMAIN-SUFFIX,ifconfig.net,US nodes
