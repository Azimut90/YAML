name: Routing & Privacy Overrides
desc: Apple/RU/BY/KG direct, Pandora via selected route, AdGuard DoH, ads/trackers filtering

mode: rule

dns:
  default-nameserver: #!replace
    - 94.140.14.14
    - 94.140.15.15

  nameserver: #!replace
    - https://dns.adguard-dns.com/dns-query

proxy-groups:
  # US nodes discovered automatically.
  - name: US nodes
    type: url-test
    include-all: true
    filter: '(?i)(🇺🇸|\bUS\b|\bUSA\b|United States|America|США|Америка|Los Angeles|New York|Chicago|Dallas|Miami|Seattle|San Jose|Ashburn|Phoenix|Atlanta|Denver|Virginia)'
    lazy: true

  # Manual choice of Pandora routing mode.
  - name: Pandora route
    type: select
    proxies:
      - "→ Remnawave"
      - US nodes

rule-providers:
  hagezi-pro-plus-mini:
    behavior: domain
    format: text
    url: https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/pro.plus.mini.txt
    path: ./rules/hagezi-pro-plus-mini.txt
    interval: 86400

rules:
  # Ads, trackers, telemetry, metrics, and common threats.
  - RULE-SET,hagezi-pro-plus-mini,REJECT,no-track

  # Apple services directly.
  - GEOSITE,apple,DIRECT

  # Russian domains/services/IPs directly.
  - GEOSITE,category-ru,DIRECT
  - GEOIP,RU,DIRECT

  # Belarus domains and IPs directly.
  - DOMAIN-SUFFIX,xn--90ais,DIRECT  # .бел
  - DOMAIN-SUFFIX,by,DIRECT
  - GEOIP,BY,DIRECT

  # Kyrgyzstan domains and IPs directly.
  - DOMAIN-SUFFIX,kg,DIRECT
  - GEOIP,KG,DIRECT

  # Pandora and related services.
  - DOMAIN-SUFFIX,pandora.com,Pandora route
  - DOMAIN-SUFFIX,p-cdn.us,Pandora route
  - DOMAIN-SUFFIX,p-cdn.com,Pandora route

  # Check selected Pandora exit node.
  - DOMAIN-SUFFIX,ifconfig.net,Pandora route
