name: Routing & Privacy Overrides
desc: Apple/RU/BY/KG direct, auto/manual/transit, Pandora via US with fallback, AdGuard DoH, HaGeZi filtering

mode: rule

dns:
  default-nameserver: #!replace
    - 94.140.14.14
    - 94.140.15.15

  nameserver: #!replace
    - https://dns.adguard-dns.com/dns-query

proxy-groups: #!replace
  - name: Main Route
    type: select
    interval: -1
    proxies:
      - Auto Select
      - Manual Select
      - US via Transit

  # Preserve the policy names referenced by the providers' original rules.
  - name: "→ Remnawave"
    type: select
    hidden: true
    interval: -1
    proxies:
      - Main Route

  - name: BlancVPN
    type: select
    hidden: true
    interval: -1
    proxies:
      - Main Route

  - name: Auto Select
    type: url-test
    include-all: true
    filter: '^(?!.*(🇷🇺|🇺🇦|🚀|❗)).+$'
    interval: 120
    tolerance: 100
    lazy: true

  # Full subscription list; the chosen node is also the preferred US transit.
  # When using US via Transit, select a non-US node here to avoid loops.
  - name: Manual Select
    type: select
    include-all: true
    interval: -1

  # Same eligible pool as Auto Select, with US additionally excluded.
  # A separate group prevents a US exit from becoming its own transit node.
  - name: Auto Transit
    type: url-test
    hidden: true
    include-all: true
    filter: '^(?!.*(🇷🇺|🇺🇦|🇺🇸|🚀|❗)).+$'
    interval: 120
    tolerance: 100
    lazy: true

  # Test the selected manual transit -> US path independently of node tests.
  - name: US via Manual
    type: relay
    hidden: true
    proxies:
      - Manual Select
      - US Exit
    benchmark-url: http://www.apple.com
    benchmark-timeout: 10
    interval: 120
    lazy: true

  # Complete backup path through a non-RU/non-UA/non-US transit node.
  - name: US via Auto
    type: relay
    hidden: true
    proxies:
      - Auto Transit
      - US Exit
    benchmark-url: http://www.apple.com
    benchmark-timeout: 10
    interval: 120
    lazy: true

  # Prefer the working Manual -> US chain, then the working Auto -> US chain.
  # Compare complete chains, including connectivity to the US exit.
  - name: US via Transit
    type: fallback
    hidden: true
    proxies:
      - US via Manual
      - US via Auto
    interval: 120
    lazy: true

  # Manually select a real US exit; retain direct-path health checks.
  # At least one US node must remain in the subscription.
  # If this group becomes empty, Stash treats it as DIRECT: no US exit.
  - name: US Exit
    type: select
    include-all: true
    filter: '^(?!.*(🚀|❗)).*🇺🇸.*$'
    interval: 120
    lazy: true

  # Prefer a direct connection TO the US proxy, then Manual -> US, then Auto -> US.
  - name: US with Fallback
    type: fallback
    proxies:
      - US Exit
      - US via Transit
    interval: 120
    lazy: true

rule-providers:
  hagezi-pro-plus-mini:
    behavior: domain
    format: text
    url: https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/pro.plus.mini.txt
    path: ./rules/hagezi-pro-plus-mini.txt
    interval: 86400

rules:
  # Ads, trackers, telemetry, metrics, and common threats.
  - RULE-SET,hagezi-pro-plus-mini,REJECT,no-track

  # Pandora and its exit-IP check take priority over broad GEOIP rules.
  - DOMAIN-SUFFIX,pandora.com,US with Fallback
  - DOMAIN-SUFFIX,p-cdn.us,US with Fallback
  - DOMAIN-SUFFIX,p-cdn.com,US with Fallback
  - DOMAIN-SUFFIX,ifconfig.net,US with Fallback

  # Apple services directly.
  - GEOSITE,apple,DIRECT

  # Russian domains and services and IP destinations directly.
  - GEOSITE,category-ru,DIRECT
  - GEOIP,RU,DIRECT

  # Belarus domains and IP destinations directly.
  - DOMAIN-SUFFIX,xn--90ais,DIRECT  # .бел
  - DOMAIN-SUFFIX,by,DIRECT
  - GEOIP,BY,DIRECT

  # Kyrgyzstan domains and IP destinations directly.
  - DOMAIN-SUFFIX,kg,DIRECT
  - GEOIP,KG,DIRECT
