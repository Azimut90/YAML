name: Routing & Privacy Overrides
desc: Apple/RU/BY/KG direct, Pandora via US, AdGuard DoH, HaGeZi filtering

mode: rule

dns:
  default-nameserver: #!replace
    - 94.140.14.14
    - 94.140.15.15

  nameserver: #!replace
    - https://dns.adguard-dns.com/dns-query

proxy-groups: #!replace
  - name: "→ Remnawave"
    type: select
    interval: -1
    proxies:
      - Automatic nodes
      - Manual nodes

  - name: Automatic nodes
    type: url-test
    include-all: true
    filter: '^(?!.*(🇷🇺|🇺🇦|🚀|❗)).+$'
    interval: 120
    tolerance: 100
    lazy: true

  - name: Manual nodes
    type: select
    include-all: true
    filter: '^(?!.*(🇷🇺|🇺🇦|🚀|❗)).+$'
    interval: -1

  - name: US nodes
    type: url-test
    include-all: true
    filter: '🇺🇸'
    interval: 120
    tolerance: 100
    lazy: true 

rule-providers:
  hagezi-pro-plus-mini:
    behavior: domain
    format: text
    url: https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/pro.plus.mini.txt
    path: ./rules/hagezi-pro-plus-mini.txt
    interval: 86400

rules:
  # Ads, trackers, telemetry, metrics, and common threats.
  - RULE-SET,hagezi-pro-plus-mini,REJECT,no-track

  # Pandora and its exit-IP check take priority over broad GEOIP rules.
  - DOMAIN-SUFFIX,pandora.com,US nodes
  - DOMAIN-SUFFIX,p-cdn.us,US nodes
  - DOMAIN-SUFFIX,p-cdn.com,US nodes
  - DOMAIN-SUFFIX,ifconfig.net,US nodes

  # Apple services directly.
  - GEOSITE,apple,DIRECT

  # Russian domains and services and IP destinations directly.
  - GEOSITE,category-ru,DIRECT
  - GEOIP,RU,DIRECT

  # Belarus domains and IP destinations directly.
  - DOMAIN-SUFFIX,xn--90ais,DIRECT  # .бел
  - DOMAIN-SUFFIX,by,DIRECT
  - GEOIP,BY,DIRECT

  # Kyrgyzstan domains and IP destinations directly.
  - DOMAIN-SUFFIX,kg,DIRECT
  - GEOIP,KG,DIRECT
